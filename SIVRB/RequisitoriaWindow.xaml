<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SIVRB.Views.RequisitoriaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Requisitoria Judicial" Height="560" Width="480" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" FontFamily="Segoe UI" ResizeMode="NoResize" xmlns:views="clr-namespace:SIVRB.Views;assembly=SIVRB">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource VerdeDk}">
      <Border BorderBrush="{StaticResource Dorado}" BorderThickness="0,0,0,3" Padding="20,12">
        <StackPanel Orientation="Horizontal">
          <Border Width="34" Height="34" Background="{StaticResource Danger}" CornerRadius="17" VerticalAlignment="Center">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Name="TxtTitulo" Text="Nueva Requisitoria" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="Complete los datos de la requisitoria judicial" Foreground="#FFFFFFA0" FontSize="10" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.Row="1" Margin="18" Style="{StaticResource CardBorder}" Padding="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,0,14">
            <TextBlock Text="PERSONA (DNI - Nombre)" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
            <ComboBox Name="CmbPersona" Style="{StaticResource PnpCombo}" DisplayMemberPath="DisplayText" Margin="0,0,0,12" />
            <TextBlock Text="DELITO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBox Name="TxtDelito" Style="{StaticResource PnpTextBox}" Margin="0,0,0,12" />
            <TextBlock Text="JUZGADO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBox Name="TxtJuzgado" Style="{StaticResource PnpTextBox}" Margin="0,0,0,12" />
            <TextBlock Text="NÚMERO DE EXPEDIENTE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBox Name="TxtExpediente" Style="{StaticResource PnpTextBox}" FontFamily="Consolas" Margin="0,0,0,12" />
            <TextBlock Text="FECHA DE EMISIÓN" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
            <DatePicker Name="DpFechaEmision" Style="{StaticResource PnpDatePicker}" Margin="0,0,0,12" />
            <TextBlock Text="DESCRIPCIÓN" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBox Name="TxtDescripcion" Style="{StaticResource PnpTextBox}" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" />
            <CheckBox Name="ChkActiva" Content="Requisitoria Activa" IsChecked="True" Foreground="{StaticResource Negro}" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </ScrollViewer>
        <Grid Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource BtnDanger}" Padding="16,10" Margin="0,0,8,0" Click="BtnGuardar_Click">
            <TextBlock Text="Guardar Requisitoria" FontWeight="Bold" />
          </Button>
          <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Padding="16,10" Content="Cancelar" Click="BtnCancelar_Click" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
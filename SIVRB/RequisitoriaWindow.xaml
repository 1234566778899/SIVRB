<Window x:Class="SIVRB.Views.RequisitoriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Requisitoria Judicial"
        Height="520" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#0a0e1a"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCardBrush" Color="#151c2e"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1e293b"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f1f5f9"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#475569"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3b82f6"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#1d4ed8"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#ef4444"/>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titulo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="18" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtTitulo" Text="Nueva Requisitoria" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Text="Complete los datos de la requisitoria judicial" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="PERSONA (DNI - Nombre)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbPersona" Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13"
                          DisplayMemberPath="DisplayText" Margin="0,0,0,12"/>

                <TextBlock Text="DELITO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDelito" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="JUZGADO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtJuzgado" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="NUMERO DE EXPEDIENTE" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtExpediente" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="FECHA DE EMISION" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <DatePicker x:Name="DpFechaEmision" Background="{StaticResource BgCardBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Text="DESCRIPCION" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDescripcion" Style="{StaticResource DarkTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                <CheckBox x:Name="ChkActiva" Content="Requisitoria Activa" IsChecked="True"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="💾 Guardar Requisitoria"
                    Foreground="White" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                    Click="BtnGuardar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="16,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#dc2626" Offset="0"/>
                                    <GradientStop Color="#ef4444" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="1" Content="Cancelar"
                    Foreground="#94a3b8" FontSize="12" Cursor="Hand"
                    Click="BtnCancelar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="16,10" Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgCardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>

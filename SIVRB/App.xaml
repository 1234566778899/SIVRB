<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="SIVRB.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:h="clr-namespace:Helpers;assembly=Helpers" xmlns:sivrb="clr-namespace:SIVRB;assembly=SIVRB">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <wpf:BundledTheme xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf" BaseTheme="Light" PrimaryColor="Green" SecondaryColor="Amber" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <h:PercentageConverter x:Key="Pct" />
      <Color x:Key="VerdeColor">#279448</Color>
      <Color x:Key="VerdeDkColor">#1A6B32</Color>
      <Color x:Key="VerdeLkColor">#EDFAF2</Color>
      <Color x:Key="DoradoColor">#CCB26D</Color>
      <Color x:Key="DoradoDkColor">#A8903A</Color>
      <Color x:Key="CelesteColor">#68A7DE</Color>
      <Color x:Key="DangerColor">#C0392B</Color>
      <Color x:Key="WarnColor">#7D5A00</Color>
      <SolidColorBrush x:Key="Verde" Color="{StaticResource VerdeColor}" />
      <SolidColorBrush x:Key="VerdeDk" Color="{StaticResource VerdeDkColor}" />
      <SolidColorBrush x:Key="VerdeLk" Color="{StaticResource VerdeLkColor}" />
      <SolidColorBrush x:Key="Dorado" Color="{StaticResource DoradoColor}" />
      <SolidColorBrush x:Key="DoradoDk" Color="{StaticResource DoradoDkColor}" />
      <SolidColorBrush x:Key="Celeste" Color="{StaticResource CelesteColor}" />
      <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="DangerBg" Color="#FDF0EF" />
      <SolidColorBrush x:Key="WarnBg" Color="#FFFBEC" />
      <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
      <SolidColorBrush x:Key="SuccessBg" Color="#EDFAF2" />
      <SolidColorBrush x:Key="Bg" Color="#F0F2F0" />
      <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Border" Color="#DCE5DE" />
      <SolidColorBrush x:Key="Negro" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Muted" Color="#6B7A6E" />
      <SolidColorBrush x:Key="Gris" Color="#9B9B9A" />
      <SolidColorBrush x:Key="SidebarBg" Color="#132D1A" />
      <SolidColorBrush x:Key="SidebarItemMute" Color="#6A9A72" />
      <SolidColorBrush x:Key="WarnBorder" Color="#F0D070" />
      <SolidColorBrush x:Key="WarnPill" Color="#FDE68A" />
      <Style x:Key="BtnMain" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource Verde}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" CornerRadius="8" SnapsToDevicePixels="True">
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="{StaticResource VerdeDk}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BtnGhost" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="Foreground" Value="{StaticResource Negro}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True" BorderBrush="{StaticResource Border}">
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="{StaticResource Bg}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BtnDanger" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource Danger}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" CornerRadius="8" SnapsToDevicePixels="True">
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PnpTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{StaticResource Negro}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource Negro}" />
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8" Padding="0">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsFocused" Value="True">
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Verde}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PnpCombo" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource Negro}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <ToggleButton Name="ToggleButton" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Border Name="cBd" BorderThickness="1" CornerRadius="8" Padding="12,8" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ContentPresenter Grid.Column="0" />
                          <TextBlock Grid.Column="1" Text="" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Muted}" />
                        </Grid>
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </ToggleButton>
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" Margin="14,9,30,9" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                  <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}">
                    <Border BorderThickness="1" CornerRadius="8" Margin="0,2,0,0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}">
                      <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </Popup>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Background" Value="#00FFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource Negro}" />
              <Setter Property="Padding" Value="12,8" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="Bd" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" CornerRadius="6">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                        <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource VerdeLk}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PnpDatePicker" TargetType="{x:Type DatePicker}">
        <Setter Property="Foreground" Value="{StaticResource Negro}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DatePicker}">
              <Border BorderThickness="1" CornerRadius="8" Padding="12,8" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <DatePickerTextBox Name="PART_TextBox" Background="#00FFFFFF" BorderThickness="0" FontSize="12" VerticalAlignment="Center" Focusable="{TemplateBinding UIElement.Focusable}" Foreground="{StaticResource Negro}" />
                  <Button Name="PART_Button" Grid.Column="1" Focusable="False" VerticalAlignment="Center">
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="8,0,0,0" Foreground="{StaticResource Muted}" />
                      </ControlTemplate>
                    </Control.Template>
                  </Button>
                  <Popup Name="PART_Popup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CardBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Border.Padding" Value="14,12" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
                                        <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                                          <Setter Property="Background" Value="#A2D8B5" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                  <TextBlock FontSize="11" FontWeight="Bold">
                                    <FrameworkElement.Style>
                                      <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="#9B1C1C" />
                                        <Setter Property="Text" Value="No disponible" />
                                        <Style.Triggers>
                                          <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                                            <Setter Property="Text" Value="Disponible" />
                                            <Setter Property="Foreground" Value="{StaticResource VerdeDk}" />
                                          </DataTrigger>
                                        </Style.Triggers>

                          <StackPanel>
                            <!-- Icono: dos anillos y punto central; gris si el sensor esta desconectado -->
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                              <Grid.Resources>
                                <Style x:Key="SensorRing" TargetType="{x:Type Border}">
                                  <Setter Property="BorderBrush" Value="{StaticResource Verde}" />
                                  <Style.Triggers>
                                    <DataTrigger Value="False" Binding="{Binding SensorConectado}">
                                      <Setter Property="BorderBrush" Value="#CFCFCF" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Grid.Resources>
                              <Border Width="68" Height="68" CornerRadius="34" BorderThickness="3" Style="{StaticResource SensorRing}">
                                <Border Width="46" Height="46" CornerRadius="23" BorderThickness="2" Style="{StaticResource SensorRing}">
                                  <Ellipse Width="22" Height="22">
                                    <FrameworkElement.Style>
                                      <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{StaticResource Verde}" />

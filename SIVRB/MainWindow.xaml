                    <WrapPanel>
                      <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,0,6,6">
                        <TextBlock Foreground="{StaticResource Negro}" FontSize="11" Text="{Binding PersonaSeleccionada.DNI, StringFormat=DNI {0}}" />
                      </Border>
                      <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,0,6,6">

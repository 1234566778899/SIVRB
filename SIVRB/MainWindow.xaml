<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SIVRB.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:ViewModels;assembly=ViewModels" Title="SIVRB - Sistema de Verificacion Biometrica en Tiempo Real" Height="900" Width="1480" MinHeight="780" MinWidth="1280" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="{StaticResource Bg}" FontFamily="Segoe UI" xmlns:views="clr-namespace:SIVRB.Views;assembly=SIVRB">
  <FrameworkElement.DataContext>
    <vm:MainViewModel />
  </FrameworkElement.DataContext>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="NavButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="b" Background="#00FFFFFF" CornerRadius="10" BorderThickness="1" BorderBrush="#00FFFFFF">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Border.Background" Value="#1F3F26" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TopBadge" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="20" />
        <Setter Property="Border.Padding" Value="10,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="{StaticResource Bg}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource VerdeDk}">
        <Border BorderBrush="{StaticResource Dorado}" BorderThickness="0,0,0,3">
          <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="38" Height="38" Background="{StaticResource Dorado}" CornerRadius="19" VerticalAlignment="Center">
              <TextBlock Text="PNP" Foreground="{StaticResource VerdeDk}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock Text="SIVRB" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" />
              <TextBlock Text="Sistema de Verificación Biométrica" Foreground="#FFFFFFA0" FontSize="10" />
            </StackPanel>
            <Border Grid.Column="2" Width="1" Height="28" Background="#FFFFFF33" Margin="16,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
              <TextBlock Text="Comisaría de Villa Chorrillos" Foreground="#FFFFFFFF" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="Verificación biométrica en tiempo real" Foreground="#FFFFFF8C" FontSize="10" Margin="0,1,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
              <Border VerticalAlignment="Center" Padding="10,5" CornerRadius="20" BorderThickness="1">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="#26FFC107" />
                    <Setter Property="BorderBrush" Value="#59FFC107" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                        <Setter Property="Background" Value="#264CAF50" />
                        <Setter Property="BorderBrush" Value="#594CAF50" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Ellipse}">
                        <Setter Property="Fill" Value="#FFD54F" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                            <Setter Property="Fill" Value="#81C784" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Ellipse>
                  <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding EstadoSensor}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="#FFD54F" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                            <Setter Property="Foreground" Value="#81C784" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TopBadge}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                  <TextBlock Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding NombreUsuarioActual}" />
                </StackPanel>
              </Border>
              <Button Name="BtnGestionUsuarios" Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center" Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVis}}" Click="BtnGestionUsuarios_Click">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="bd" Style="{StaticResource TopBadge}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Usuarios" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Border.Background" Value="#33FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </Button>
              <Button Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center" Click="BtnCerrarSesion_Click">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="bd" Background="#00FFFFFF" BorderBrush="#FFFFFF55" BorderThickness="1" CornerRadius="8" Padding="14,5">
                      <TextBlock Text="Salir" Foreground="#FFFFFFCC" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Border.Background" Value="#FFFFFF1A" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
      <Border Grid.Row="1" Background="{StaticResource Verde}" Padding="20,5">
        <StackPanel Orientation="Horizontal">
          <TextBlock Foreground="#FFFFFFC0" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="PANEL DE CONTROL" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding EsOperaciones}">
                    <Setter Property="Text" Value="OPERACIONES — VERIFICACIÓN Y REGISTRO" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <Border Background="{StaticResource Dorado}" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="EN LÍNEA" Foreground="{StaticResource VerdeDk}" FontSize="9" FontWeight="Bold" />
          </Border>
        </StackPanel>
      </Border>
      <Grid Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="68" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource DoradoDk}" BorderThickness="0,0,2,0">
          <StackPanel HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Cursor="Hand" Width="46" Height="54" Margin="0,0,0,6" Command="{Binding IrDashboardCommand}" Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVis}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Name="b" CornerRadius="10" BorderThickness="1">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#00FFFFFF" />
                        <Setter Property="BorderBrush" Value="#00FFFFFF" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding EsDashboard}">
                            <Setter Property="Background" Value="#26CCB26D" />
                            <Setter Property="BorderBrush" Value="#66CCB26D" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#4A7A52" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding EsDashboard}">
                                <Setter Property="Foreground" Value="{StaticResource Dorado}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                      <TextBlock Text="Panel" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#6A9A72" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding EsDashboard}">
                                <Setter Property="Foreground" Value="{StaticResource Dorado}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Border.Background" Value="#1F3F26" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </Button>
            <Button Cursor="Hand" Width="46" Height="54" Margin="0,0,0,6" Command="{Binding IrOperacionesCommand}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Name="b" CornerRadius="10" BorderThickness="1">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#00FFFFFF" />
                        <Setter Property="BorderBrush" Value="#00FFFFFF" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding EsOperaciones}">
                            <Setter Property="Background" Value="#26CCB26D" />
                            <Setter Property="BorderBrush" Value="#66CCB26D" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#4A7A52" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding EsOperaciones}">
                                <Setter Property="Foreground" Value="{StaticResource Dorado}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                      <TextBlock Text="Operar" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#6A9A72" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding EsOperaciones}">
                                <Setter Property="Foreground" Value="{StaticResource Dorado}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Border.Background" Value="#1F3F26" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </Button>
          </StackPanel>
        </Border>
        <Grid Column="1">
          <Grid Visibility="{Binding EsDashboard, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="18,16">
                <UniformGrid Columns="4">
                  <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                    <Grid>
                      <Border HorizontalAlignment="Left" Width="4" CornerRadius="10,0,0,10" Background="{StaticResource Verde}" />
                      <StackPanel Margin="10,0,0,0">
                        <Border Width="34" Height="34" Background="{StaticResource VerdeLk}" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,10">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Verde}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Foreground="{StaticResource Negro}" FontSize="30" FontWeight="Bold" Text="{Binding TotalRegistrados}" />
                        <TextBlock Text="Registrados" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                    <Grid>
                      <Border HorizontalAlignment="Left" Width="4" CornerRadius="10,0,0,10" Background="{StaticResource Danger}" />
                      <StackPanel Margin="10,0,0,0">
                        <Border Width="34" Height="34" Background="{StaticResource DangerBg}" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,10">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Foreground="{StaticResource Danger}" FontSize="30" FontWeight="Bold" Text="{Binding TotalRequisitorias}" />
                        <TextBlock Text="Requisitorias" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                    <Grid>
                      <Border HorizontalAlignment="Left" Width="4" CornerRadius="10,0,0,10" Background="{StaticResource Celeste}" />
                      <StackPanel Margin="10,0,0,0">
                        <Border Width="34" Height="34" Background="#EEF5FC" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,10">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Celeste}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Foreground="{StaticResource Celeste}" FontSize="30" FontWeight="Bold" Text="{Binding VerificacionesHoy}" />
                        <TextBlock Text="Verificaciones hoy" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                    <Grid>
                      <Border HorizontalAlignment="Left" Width="4" CornerRadius="10,0,0,10" Background="{StaticResource Dorado}" />
                      <StackPanel Margin="10,0,0,0">
                        <Border Width="34" Height="34" Background="#FDF8EC" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,10">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Dorado}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Foreground="{StaticResource DoradoDk}" FontSize="30" FontWeight="Bold" Text="{Binding CapturasHoy}" />
                        <TextBlock Text="Capturas hoy" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </UniformGrid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <TextBlock Text="Registros por mes" Foreground="{StaticResource Negro}" FontSize="13" FontWeight="Bold" />
                      <TextBlock Text="Últimos 6 meses" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,12" />
                      <ItemsControl Height="120" ItemsSource="{Binding RegistrosPorMes}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="3,0">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <TextBlock Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3" Text="{Binding Value}" />
                              <Grid Row="1" VerticalAlignment="Bottom">
                                <Border CornerRadius="3,3,0,0" Background="#B0D8BC" Height="{Binding Percentage, Converter={StaticResource Pct}, ConverterParameter=90}" />
                              </Grid>
                              <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0" Text="{Binding Label}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <TextBlock Text="Verificaciones por día" Foreground="{StaticResource Negro}" FontSize="13" FontWeight="Bold" />
                      <TextBlock Text="Últimos 7 días" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,12" />
                      <ItemsControl Height="120" ItemsSource="{Binding VerificacionesPorDia}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="3,0">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <TextBlock Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3" Text="{Binding Value}" />
                              <Grid Row="1" VerticalAlignment="Bottom">
                                <Border CornerRadius="3,3,0,0" Background="#B8D8F0" Height="{Binding Percentage, Converter={StaticResource Pct}, ConverterParameter=90}" />
                              </Grid>
                              <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0" Text="{Binding Label}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="320" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Registros recientes" Foreground="{StaticResource Negro}" FontSize="13" FontWeight="Bold" />
                          <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="{Binding TotalRegistrados, StringFormat='{}{0} personas registradas'}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource BtnMain}" Padding="12,6" Command="{Binding IrOperacionesCommand}">
                          <TextBlock Text="Ir a Operaciones" FontSize="11" FontWeight="Bold" />
                        </Button>
                      </Grid>
                      <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,2" Padding="0,4,0,5">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="NOMBRE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" />
                          <TextBlock Grid.Column="1" Text="DNI" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" />
                          <TextBlock Grid.Column="2" Text="MOTIVO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" />
                          <TextBlock Grid.Column="3" Text="FECHA" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" />
                          <TextBlock Grid.Column="4" Text="ESTADO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" />
                        </Grid>
                      </Border>
                      <ItemsControl ItemsSource="{Binding Personas}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{StaticResource Bg}" BorderThickness="0,0,0,1" Padding="0,7">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="2*" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource Negro}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding NombreCompleto}" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Text="{Binding DNI}" />
                                <TextBlock Grid.Column="2" Foreground="{StaticResource Negro}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding MotivoRegistro}" />
                                <TextBlock Grid.Column="3" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Text="{Binding FechaRegistro, StringFormat='{}{0:dd/MM/yyyy}'}" />
                                <Border Grid.Column="4" HorizontalAlignment="Left" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Border}">
                                      <Setter Property="Background" Value="{StaticResource SuccessBg}" />
                                      <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding Requisitoria.Activa}">
                                          <Setter Property="Background" Value="{StaticResource DangerBg}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                  <TextBlock FontSize="9" FontWeight="Bold">
                                    <FrameworkElement.Style>
                                      <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="Verificado" />
                                        <Setter Property="Foreground" Value="{StaticResource VerdeDk}" />
                                        <Style.Triggers>
                                          <DataTrigger Value="True" Binding="{Binding Requisitoria.Activa}">
                                            <Setter Property="Text" Value="Requisitoria" />
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </FrameworkElement.Style>
                                  </TextBlock>
                                </Border>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}">
                      <StackPanel>
                        <TextBlock Text="Sensor biométrico" Foreground="{StaticResource Negro}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                        <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="14">
                          <StackPanel>
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,10">
                              <Border Width="60" Height="60" CornerRadius="30" BorderThickness="2.5">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type Border}">
                                    <Setter Property="BorderBrush" Value="{StaticResource Verde}" />
                                    <Style.Triggers>
                                      <DataTrigger Value="False" Binding="{Binding SensorConectado}">
                                        <Setter Property="BorderBrush" Value="#C9C9C9" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>

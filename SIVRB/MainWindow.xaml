              </Border>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Style="{StaticResource CardBorder}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="ESTADO DEL SENSOR" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Sensor biométrico" Foreground="{StaticResource Negro}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                      </StackPanel>
                      <Border Grid.Column="1" Padding="9,4" CornerRadius="10" VerticalAlignment="Top">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="{StaticResource DangerBg}" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                                <Setter Property="Background" Value="{StaticResource SuccessBg}" />
                              </DataTrigger>
                              <DataTrigger Value="True" Binding="{Binding ResultadoVisible}">
                                <Setter Property="Background" Value="#EEF5FC" />
                              </DataTrigger>
                              <DataTrigger Value="True" Binding="{Binding AlertaRequisitoria}">
                                <Setter Property="Background" Value="{StaticResource DangerBg}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                        <TextBlock FontSize="11" FontWeight="Bold">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Setter Property="Text" Value="Desconectado" />
                              <Setter Property="Foreground" Value="{StaticResource Danger}" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                                  <Setter Property="Text" Value="Conectado" />
                                  <Setter Property="Foreground" Value="{StaticResource VerdeDk}" />
                                </DataTrigger>
                                <DataTrigger Value="True" Binding="{Binding ResultadoVisible}">
                                  <Setter Property="Text" Value="Resultado listo" />
                                  <Setter Property="Foreground" Value="{StaticResource Celeste}" />
                                </DataTrigger>
                                <DataTrigger Value="True" Binding="{Binding AlertaRequisitoria}">
                                  <Setter Property="Text" Value="Alerta activa" />
                                  <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </TextBlock>
                      </Border>
                    </Grid>
                    <Border Margin="0,14,0,12" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="14" Height="240">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0" />
                          <TextBlock Text="Sensor ZK4500" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                        <!-- Icono del sensor: verde y con pulso si esta conectado; gris y quieto si no -->
                        <Grid Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Grid.Resources>
                            <Style x:Key="OpRing" TargetType="{x:Type Border}">
                              <Setter Property="BorderBrush" Value="#CFCFCF" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                                  <Setter Property="BorderBrush" Value="{StaticResource Verde}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Grid.Resources>
                          <Border Name="PulseRing" Width="160" Height="160" CornerRadius="80" BorderThickness="2.5" BorderBrush="{StaticResource Verde}" Opacity="0" Visibility="{Binding SensorConectado, Converter={StaticResource BoolToVis}}">
                            <FrameworkElement.Triggers>
                              <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                  <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0" To="0.55" Duration="0:0:1.2" AutoReverse="True" />
                                  </Storyboard>
                                </BeginStoryboard>
                              </EventTrigger>
                            </FrameworkElement.Triggers>
                          </Border>
                          <Border Width="120" Height="120" CornerRadius="60" BorderThickness="3" Style="{StaticResource OpRing}">
                            <Border Width="80" Height="80" CornerRadius="40" BorderThickness="2" Style="{StaticResource OpRing}">
                              <Ellipse Width="40" Height="40">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="#BDBDBD" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                                        <Setter Property="Fill" Value="{StaticResource Verde}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </Ellipse>
                            </Border>
                          </Border>
                        </Grid>
                        <StackPanel Grid.Row="2">
                          <TextBlock Foreground="{StaticResource Negro}" FontSize="14" FontWeight="Bold" TextAlignment="Center" Text="{Binding EstadoVerificacion}" />
                          <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding EstadoVerificacionDetalle}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Button Style="{StaticResource BtnMain}" Padding="0,10" Command="{Binding VerificarHuellaCommand}">
                      <TextBlock Text="Verificar huella" />
                    </Button>
                  </StackPanel>
                </Border>
                <Border Margin="0,12,0,0" Background="{StaticResource DangerBg}" BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="10" Visibility="{Binding AlertaRequisitoria, Converter={StaticResource BoolToVis}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="5" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Danger}" CornerRadius="10,0,0,10" />
                    <StackPanel Grid.Column="1" Margin="14">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="ALERTA DEL SISTEMA" Foreground="{StaticResource Danger}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="Requisitoria detectada" Foreground="{StaticResource Danger}" FontSize="16" FontWeight="Bold" Margin="0,6,0,0" />
                      <TextBlock Foreground="{StaticResource Negro}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding AlertaMensaje}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Margin="0,12,0,0" Style="{StaticResource CardBorder}" Visibility="{Binding ResultadoVisible, Converter={StaticResource BoolToVis}}">
                  <StackPanel>
                    <TextBlock Text="RESULTADO DE VERIFICACIÓN" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                    <TextBlock Foreground="{StaticResource Negro}" FontSize="16" FontWeight="Bold" Margin="0,6,0,0" Text="{Binding PersonaVerificada.NombreCompleto}" />
                    <TextBlock FontSize="11" FontWeight="Bold" Margin="0,4,0,10">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Text" Value="Verificación exitosa sin alerta activa" />
                          <Setter Property="Foreground" Value="{StaticResource VerdeDk}" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding AlertaRequisitoria}">
                              <Setter Property="Text" Value="Verificación con requisitoria activa" />
                              <Setter Property="Foreground" Value="{StaticResource Danger}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="DNI" Foreground="{StaticResource Muted}" FontSize="11" />
                      <TextBlock Grid.Column="1" Foreground="{StaticResource Negro}" FontSize="11" FontFamily="Consolas" Text="{Binding PersonaVerificada.DNI}" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Coincidencia" Foreground="{StaticResource Muted}" FontSize="11" />
                      <TextBlock Grid.Column="1" Foreground="{StaticResource Negro}" FontSize="11" FontFamily="Consolas" Text="{Binding Path=PorcentajeCoincidencia, StringFormat='{}{0:F1}% de match'}" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" Visibility="{Binding PanelRequisitoriaVisible, Converter={StaticResource BoolToVis}}">
                  <StackPanel>
                    <TextBlock Text="GESTIÓN DE REQUISITORIA" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                    <TextBlock Foreground="{StaticResource Negro}" FontSize="15" FontWeight="Bold" Margin="0,6,0,0" Text="{Binding TituloRequisitoria}" />
                    <Border Margin="0,10,0,0" Padding="10" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                      <TextBlock Foreground="{StaticResource Negro}" FontSize="11" TextWrapping="Wrap" Text="{Binding ReqPersonaInfo}" />
                    </Border>
                    <TextBlock Text="Delito" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource PnpTextBox}" Text="{Binding ReqDelito, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Juzgado" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource PnpTextBox}" Text="{Binding ReqJuzgado, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Número de expediente" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource PnpTextBox}" FontFamily="Consolas" Text="{Binding ReqExpediente, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Fecha de emisión" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4" />
                    <DatePicker Style="{StaticResource PnpDatePicker}" SelectedDate="{Binding ReqFechaEmision}" />
                    <TextBlock Text="Descripción" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource PnpTextBox}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding ReqDescripcion, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource InlineErrorText}" Margin="0,10,0,0" Text="{Binding MensajeRequisitoria}" />
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                      <Button Style="{StaticResource BtnMain}" Margin="0,0,4,6" Command="{Binding GuardarRequisitoriaCommand}" Content="{Binding TextoBotonRequisitoria}" />
                      <Button Style="{StaticResource BtnGhost}" Margin="4,0,0,6" Content="Cerrar panel" Command="{Binding CancelarRequisitoriaCommand}" />
                      <Button Style="{StaticResource BtnDanger}" Margin="0,0,0,0" Grid.ColumnSpan="2" Content="Eliminar requisitoria" Command="{Binding EliminarRequisitoriaCommand}" Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVis}}" />
                    </UniformGrid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
      <Border Grid.Row="3" Background="{StaticResource VerdeDk}" Padding="20,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="POLICÍA NACIONAL DEL PERÚ — SIVRB v1.0 — DIOS, PATRIA Y LEY" Foreground="#FFFFFF80" FontSize="10" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="COMISARÍA VILLA CHORRILLOS" Foreground="{StaticResource Dorado}" FontSize="10" FontWeight="Bold" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
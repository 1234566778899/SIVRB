                      </StackPanel>
                    </Border>
                    <!-- ===== Registros por motivo ===== -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                      <StackPanel>
                        <TextBlock Text="Registros por motivo" Foreground="{StaticResource Negro}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Distribución general" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,14" />
                        <TextBlock Style="{StaticResource EmptyStateText}" HorizontalAlignment="Left" Margin="0,0,0,8" Text="Sin registros todavía" Visibility="{Binding HayRegistrosPorMotivo, Converter={StaticResource InvBoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding RegistrosPorMotivo}">

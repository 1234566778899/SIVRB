                                          <DataTrigger Value="False" Binding="{Binding SensorConectado}">
                                            <Setter Property="Fill" Value="#BDBDBD" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </FrameworkElement.Style>
                                  </Ellipse>
                                </Border>
                              </Border>
                            </Grid>
                            <TextBlock Text="ZK4500" Foreground="{StaticResource Negro}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Sensor ZK4500" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,14" />

<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SIVRB.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:ViewModels;assembly=ViewModels" Title="SIVRB - Sistema de Verificación Biométrica en Tiempo Real" Height="900" Width="1480" MinHeight="780" MinWidth="1280" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="{StaticResource Bg}" FontFamily="Segoe UI" xmlns:views="clr-namespace:SIVRB.Views;assembly=SIVRB">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="NavButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="b" Background="#00FFFFFF" CornerRadius="10" BorderThickness="1" BorderBrush="#00FFFFFF">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Border.Background" Value="#1F3F26" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="{StaticResource Bg}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource VerdeDk}">
        <Border BorderBrush="{StaticResource Dorado}" BorderThickness="0,0,0,3">
          <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="38" Height="38" Background="{StaticResource Dorado}" CornerRadius="19" VerticalAlignment="Center">
              <TextBlock Text="PNP" Foreground="{StaticResource VerdeDk}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock Text="SIVRB" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" />
              <TextBlock Text="Sistema de Verificación Biométrica" Foreground="#FFFFFFA0" FontSize="11" />
            </StackPanel>
            <Border Grid.Column="2" Width="1" Height="28" Background="#FFFFFF33" Margin="16,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
              <TextBlock Text="Comisaría de Villa Chorrillos" Foreground="#FFFFFFFF" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="Verificación biométrica en tiempo real" Foreground="#FFFFFF8C" FontSize="11" Margin="0,1,0,0" />
            </StackPanel>
            <!-- Derecha del encabezado: indicadores (no interactivos) y un unico boton: Cerrar sesion.
                 La gestion de usuarios se movio a la barra lateral porque es navegacion. -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Estado del sensor: punto + texto, sin forma de boton -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Estado del lector de huellas ZK4500">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Ellipse}">
                      <Setter Property="Fill" Value="#FF8A80" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                          <Setter Property="Fill" Value="#81C784" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Ellipse>
                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Text" Value="Sensor desconectado" />
                      <Setter Property="Foreground" Value="#FFCDD2" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding SensorConectado}">
                          <Setter Property="Text" Value="Sensor conectado" />
                          <Setter Property="Foreground" Value="#C8E6C9" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
              </StackPanel>
              <Border Width="1" Height="28" Background="#FFFFFF33" Margin="18,0" VerticalAlignment="Center" />
              <!-- Usuario actual: solo informativo -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="15" Background="#26FFFFFF" VerticalAlignment="Center">
                  <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFFFFF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold" Text="{Binding NombreUsuarioActual}" />
                  <TextBlock FontSize="11" Foreground="#FFFFFFA0">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="Operador" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding EsAdministrador}">
                            <Setter Property="Text" Value="Administrador" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </StackPanel>
              </StackPanel>
              <!-- Unico boton del encabezado -->
              <Button Style="{x:Null}" AutomationProperties.Name="Cerrar sesión" Margin="16,0,0,0" Cursor="Hand" VerticalAlignment="Center" Click="BtnCerrarSesion_Click">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="bd" Background="#00FFFFFF" BorderBrush="#FFFFFF66" BorderThickness="1" CornerRadius="8" Padding="14,6">
                      <TextBlock Text="Cerrar sesión" Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Border.Background" Value="#FFFFFF1F" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
      <Border Grid.Row="1" Background="{StaticResource Verde}" Padding="20,5">
        <StackPanel Orientation="Horizontal">
          <TextBlock Foreground="#FFFFFFC0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="PANEL DE CONTROL" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding EsOperaciones}">
                    <Setter Property="Text" Value="OPERACIONES — VERIFICACIÓN Y REGISTRO" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </StackPanel>
      </Border>
      <Grid Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="76" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource DoradoDk}" BorderThickness="0,0,2,0">
          <StackPanel HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Style="{x:Null}" Cursor="Hand" Width="58" Height="56" Margin="0,0,0,6" AutomationProperties.Name="Panel" Command="{Binding IrDashboardCommand}" Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVis}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Name="b" CornerRadius="10" BorderThickness="1">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#00FFFFFF" />
                        <Setter Property="BorderBrush" Value="#00FFFFFF" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding EsDashboard}">
                            <Setter Property="Background" Value="#26CCB26D" />
                            <Setter Property="BorderBrush" Value="#66CCB26D" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#4A7A52" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding EsDashboard}">
                                <Setter Property="Foreground" Value="{StaticResource Dorado}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                      <TextBlock Text="Panel" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#6A9A72" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding EsDashboard}">
                                <Setter Property="Foreground" Value="{StaticResource Dorado}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Border.Background" Value="#1F3F26" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </Button>
            <Button Style="{x:Null}" Cursor="Hand" Width="58" Height="56" Margin="0,0,0,6" AutomationProperties.Name="Operar" Command="{Binding IrOperacionesCommand}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Name="b" CornerRadius="10" BorderThickness="1">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#00FFFFFF" />
                        <Setter Property="BorderBrush" Value="#00FFFFFF" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding EsOperaciones}">
                            <Setter Property="Background" Value="#26CCB26D" />
                            <Setter Property="BorderBrush" Value="#66CCB26D" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#4A7A52" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding EsOperaciones}">
                                <Setter Property="Foreground" Value="{StaticResource Dorado}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                      <TextBlock Text="Operar" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#6A9A72" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding EsOperaciones}">
                                <Setter Property="Foreground" Value="{StaticResource Dorado}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Border.Background" Value="#1F3F26" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </Button>
            <!-- Gestion de usuarios (solo administradores). Antes estaba en el encabezado. -->
            <Button Name="BtnGestionUsuarios" AutomationProperties.Name="Usuarios" Style="{StaticResource NavButton}" Click="BtnGestionUsuarios_Click" ToolTip="Gestión de usuarios" Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVis}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#4A7A52" HorizontalAlignment="Center" />
                <TextBlock Text="Usuarios" FontSize="11" FontWeight="SemiBold" Foreground="#6A9A72" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <Grid Column="1">
          <Grid Visibility="{Binding EsDashboard, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="18,16">
                <UniformGrid Columns="4">
                  <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                    <Grid>
                      <Border HorizontalAlignment="Left" Width="4" CornerRadius="10,0,0,10" Background="{StaticResource Verde}" />
                      <StackPanel Margin="10,0,0,0">
                        <Border Width="34" Height="34" Background="{StaticResource VerdeLk}" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,10">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Verde}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Foreground="{StaticResource Negro}" FontSize="30" FontWeight="Bold" Text="{Binding TotalRegistrados}" />
                        <TextBlock Text="Registrados" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                    <Grid>
                      <Border HorizontalAlignment="Left" Width="4" CornerRadius="10,0,0,10" Background="{StaticResource Danger}" />
                      <StackPanel Margin="10,0,0,0">
                        <Border Width="34" Height="34" Background="{StaticResource DangerBg}" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,10">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Foreground="{StaticResource Danger}" FontSize="30" FontWeight="Bold" Text="{Binding TotalRequisitorias}" />
                        <TextBlock Text="Requisitorias" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                    <Grid>
                      <Border HorizontalAlignment="Left" Width="4" CornerRadius="10,0,0,10" Background="{StaticResource Celeste}" />
                      <StackPanel Margin="10,0,0,0">
                        <Border Width="34" Height="34" Background="#EEF5FC" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,10">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Celeste}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Foreground="{StaticResource Celeste}" FontSize="30" FontWeight="Bold" Text="{Binding VerificacionesHoy}" />
                        <TextBlock Text="Verificaciones hoy" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                    <Grid>
                      <Border HorizontalAlignment="Left" Width="4" CornerRadius="10,0,0,10" Background="{StaticResource Dorado}" />
                      <StackPanel Margin="10,0,0,0">
                        <Border Width="34" Height="34" Background="#FDF8EC" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,10">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Dorado}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Foreground="{StaticResource DoradoDk}" FontSize="30" FontWeight="Bold" Text="{Binding CapturasHoy}" />
                        <TextBlock Text="Capturas hoy" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </UniformGrid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <TextBlock Text="Registros por mes" Foreground="{StaticResource Negro}" FontSize="13" FontWeight="Bold" />
                      <TextBlock Text="Últimos 6 meses" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,12" />
                      <Grid Height="120">
                      <ItemsControl ItemsSource="{Binding RegistrosPorMes}" Visibility="{Binding HayRegistrosPorMes, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="3,0">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <TextBlock Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3" Text="{Binding Value}" />
                              <Grid Row="1" VerticalAlignment="Bottom">
                                <Border CornerRadius="3,3,0,0" Background="#B0D8BC" Height="{Binding Percentage, Converter={StaticResource Pct}, ConverterParameter=90}" />
                              </Grid>
                              <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Text="{Binding Label}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Style="{StaticResource EmptyStateText}" Text="Sin registros en los últimos 6 meses" Visibility="{Binding HayRegistrosPorMes, Converter={StaticResource InvBoolToVis}}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <TextBlock Text="Verificaciones por día" Foreground="{StaticResource Negro}" FontSize="13" FontWeight="Bold" />
                      <TextBlock Text="Últimos 7 días" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,12" />
                      <Grid Height="120">
                      <ItemsControl ItemsSource="{Binding VerificacionesPorDia}" Visibility="{Binding HayVerificacionesPorDia, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="3,0">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <TextBlock Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3" Text="{Binding Value}" />
                              <Grid Row="1" VerticalAlignment="Bottom">
                                <Border CornerRadius="3,3,0,0" Background="#B8D8F0" Height="{Binding Percentage, Converter={StaticResource Pct}, ConverterParameter=90}" />
                              </Grid>
                              <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Text="{Binding Label}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Style="{StaticResource EmptyStateText}" Text="Sin verificaciones en los últimos 7 días" Visibility="{Binding HayVerificacionesPorDia, Converter={StaticResource InvBoolToVis}}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="320" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Registros recientes" Foreground="{StaticResource Negro}" FontSize="13" FontWeight="Bold" />
                          <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="Los 5 registros más recientes" />
                        </StackPanel>
                        <!-- Accion secundaria: lleva a la lista completa en Operaciones -->
                        <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Padding="12,6" VerticalAlignment="Center" Content="Ver todos" Command="{Binding IrOperacionesCommand}" />
                      </Grid>
                      <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,2" Padding="0,4,0,5">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="NOMBRE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                          <TextBlock Grid.Column="1" Text="DNI" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                          <TextBlock Grid.Column="2" Text="MOTIVO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                          <TextBlock Grid.Column="3" Text="FECHA" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                          <TextBlock Grid.Column="4" Text="ESTADO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                        </Grid>
                      </Border>
                      <!-- Estado vacio -->
                      <StackPanel Margin="0,28,0,20" Visibility="{Binding SinRegistros, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource EmptyStateText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Negro}" Text="Aún no hay personas registradas" />
                        <TextBlock Style="{StaticResource EmptyStateText}" Margin="0,4,0,12" Text="Los registros aparecerán aquí a medida que se agreguen." />
                        <Button Style="{StaticResource BtnMain}" HorizontalAlignment="Center" Padding="16,8" Content="+ Nuevo registro" Command="{Binding AbrirRegistroModalCommand}" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding PersonasRecientes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{StaticResource Bg}" BorderThickness="0,0,0,1" Padding="0,7">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="2*" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource Negro}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding NombreCompleto}" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Text="{Binding DNI}" />
                                <TextBlock Grid.Column="2" Foreground="{StaticResource Negro}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding MotivoRegistro}" />
                                <TextBlock Grid.Column="3" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Text="{Binding FechaRegistro, StringFormat='{}{0:dd/MM/yyyy}'}" />
                                <Border Grid.Column="4" HorizontalAlignment="Left" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Border}">
                                      <Setter Property="Background" Value="{StaticResource SuccessBg}" />
                                      <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding Requisitoria.Activa}">
                                          <Setter Property="Background" Value="{StaticResource DangerBg}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                  <TextBlock FontSize="10" FontWeight="Bold">
                                    <FrameworkElement.Style>
                                      <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="Verificado" />
                                        <Setter Property="Foreground" Value="{StaticResource VerdeDk}" />
                                        <Style.Triggers>
                                          <DataTrigger Value="True" Binding="{Binding Requisitoria.Activa}">
                                            <Setter Property="Text" Value="Requisitoria" />
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </FrameworkElement.Style>
                                  </TextBlock>
                                </Border>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="2">
                    <!-- ===== Sensor biometrico (diseno segun mockup) ===== -->
                    <Border Style="{StaticResource CardBorder}">
                      <StackPanel>
                        <TextBlock Text="Sensor biométrico" Foreground="{StaticResource Negro}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

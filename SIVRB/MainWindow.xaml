                            <DataTemplate>
                              <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="95" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource Negro}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Label}" ToolTip="{Binding Label}" />

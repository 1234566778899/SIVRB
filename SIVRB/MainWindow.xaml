<Window x:Class="SIVRB.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ViewModels;assembly=ViewModels"
        Title="SIVRB — Sistema de Verificacion Biometrica en Tiempo Real"
        Height="720" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#0a0e1a"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============ COLORES ============ -->
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="#0a0e1a"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="#0f1422"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#151c2e"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3b82f6"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#1d4ed8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f1f5f9"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94a3b8"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#475569"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1e293b"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#ef4444"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10b981"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#f59e0b"/>

        <!-- ============ ESTILOS ============ -->

        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgCardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarBtnActive" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Setter Property="Background" Value="#123b82f6"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DatePickerTextBox">
                                <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="8" Padding="10,8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                                    <ScrollViewer x:Name="PART_ContentHost" 
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="16,9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3b82f6" Offset="0"/>
                                    <GradientStop Color="#6366f1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#3b82f6" BlurRadius="16" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3b82f6" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="16,9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#dc2626" Offset="0"/>
                                    <GradientStop Color="#ef4444" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#ef4444" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="16,9"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgCardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="16,9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#d97706" Offset="0"/>
                                    <GradientStop Color="#f59e0b" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#f59e0b" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton pequeno inline -->
        <Style x:Key="SmallDangerBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,5"
                                Background="Transparent"
                                BorderBrush="#30ef4444" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12ef4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallWarningBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,5"
                                Background="Transparent"
                                BorderBrush="#30f59e0b" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12f59e0b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallSuccessBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,5"
                                Background="Transparent"
                                BorderBrush="#3010b981" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1210b981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- ======== CAMBIO 1: COMBOBOX OSCURO COMPLETO ======== -->

        <!-- ToggleButton interno del ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="8"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                <Border Grid.Column="0" CornerRadius="8,0,0,8" Margin="1"
                        Background="Transparent"/>
                <Path x:Name="Arrow" Grid.Column="1"
                      Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextMutedBrush}"
                      StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- TextBox interno para modo editable -->
        <ControlTemplate x:Key="ComboBoxTextBox" TargetType="TextBox">
            <Border x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/>
        </ControlTemplate>

        <!-- Estilo completo del ComboBox -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,2,0,2" Width="100" MinWidth="280"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,3,28,3" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Template="{StaticResource ComboBoxTextBox}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="12,3,28,3" Focusable="True"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" CornerRadius="8"
                                            Background="{StaticResource BgCardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12"
                                                              ShadowDepth="4" Opacity="0.3"/>
                                        </Border.Effect>
                                    </Border>
                                    <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de los items del dropdown -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Padding="10,7" CornerRadius="5"
                                Background="Transparent" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ============ LAYOUT ============ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== SIDEBAR ======== -->
        <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,16,0,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1d4ed8" Offset="0"/>
                                <GradientStop Color="#3b82f6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#3b82f6" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <TextBlock Text="PNP" FontWeight="Bold" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Button Style="{StaticResource SidebarBtnActive}" Margin="0,3" ToolTip="Verificacion">
                        <Path Data="M12,22 S20,18 20,12 V5 L12,2 L4,5 V12 C4,18 12,22 12,22 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" Stretch="Uniform" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======== CONTENIDO PRINCIPAL ======== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ======== ALERTA REQUISITORIA ======== -->
            <Border Grid.Row="0" Background="#14ef4444"
                    BorderBrush="#30ef4444" BorderThickness="0,0,0,1"
                    Padding="18,10"
                    Visibility="{Binding AlertaRequisitoria, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="14" Foreground="#ef4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AlertaMensaje}" FontSize="12" FontWeight="Medium"
                               Foreground="#ef4444" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ======== TOP BAR ======== -->
            <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1d4ed8" Offset="0"/>
                                    <GradientStop Color="#1e40af" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🛡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Comisaria de Villa Chorrillos" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Sistema de Verificacion Biometrica en Tiempo Real" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <Border CornerRadius="12" Padding="10,3" Margin="14,0,0,0"
                                Background="#1210b981" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"
                                         Visibility="{Binding SensorConectado, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding EstadoSensor}" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="10,0" Height="34" Width="240">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                         VerticalAlignment="Center" CaretBrush="{StaticResource AccentBrush}"
                                         Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0"
                                Command="{Binding ActualizarDatosCommand}">
                            <TextBlock Text="↻ Actualizar" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======== AREA DE CONTENIDO ======== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- ======== PANEL IZQUIERDO ======== -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <!-- Stats -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="8" Background="#123b82f6">
                                        <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalRegistrados}" FontSize="20" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="REGISTRADOS" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCard}" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="8" Background="#12ef4444">
                                        <TextBlock Text="⚠" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalRequisitorias}" FontSize="20" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="REQUISITORIAS" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCard}" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="8" Background="#1210b981">
                                        <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VerificacionesHoy}" FontSize="20" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="VERIF. HOY" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCard}" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="8" Background="#12f59e0b">
                                        <TextBlock Text="🚨" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CapturasHoy}" FontSize="20" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="CAPTURAS HOY" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- ======== TABLA DE PERSONAS ======== -->
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <DockPanel>
                                <!-- Header con botones -->
                                <Border DockPanel.Dock="Top" Background="#10000000" Padding="16,10"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        CornerRadius="12,12,0,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="REGISTROS" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" — " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalRegistrados, StringFormat='{}{0} personas'}" 
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- Botones de requisitoria -->
                                            <Button Style="{StaticResource SmallSuccessBtn}" Margin="0,0,4,0"
                                                    Command="{Binding AbrirAgregarRequisitoriaCommand}"
                                                    ToolTip="Agregar requisitoria a persona seleccionada">
                                                <TextBlock Text="+ Req." FontSize="10"/>
                                            </Button>
                                            <Button Style="{StaticResource SmallWarningBtn}" Margin="0,0,4,0"
                                                    Command="{Binding AbrirEditarRequisitoriaCommand}"
                                                    ToolTip="Editar requisitoria de persona seleccionada">
                                                <TextBlock Text="✏ Req." FontSize="10"/>
                                            </Button>

                                            <!-- Separador visual -->
                                            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,2,8,2"/>

                                            <!-- Botones de persona -->
                                            <Button Style="{StaticResource WarningBtn}" Margin="0,0,6,0"
                                                    Command="{Binding EditarPersonaCommand}"
                                                    ToolTip="Editar persona seleccionada">
                                                <TextBlock Text="✏ Editar" FontWeight="SemiBold" FontSize="11"/>
                                            </Button>
                                            <Button Style="{StaticResource DangerBtn}"
                                                    Command="{Binding EliminarPersonaCommand}"
                                                    ToolTip="Eliminar persona seleccionada">
                                                <TextBlock Text="🗑 Eliminar" FontWeight="SemiBold" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Encabezados -->
                                <Border DockPanel.Dock="Top" Padding="16,8"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="NOMBRE" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="2" Text="DNI" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="3" Text="MOTIVO" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="4" Text="FECHA" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="5" Text="ESTADO" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </Border>

                                <!-- Lista -->
                                <ListView ItemsSource="{Binding Personas}"
                                          SelectedItem="{Binding PersonaSeleccionada}"
                                          Background="Transparent" BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="bd" Padding="16,10"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Background="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#083b82f6"/>
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#3b82f6"/>
                                                                <Setter TargetName="bd" Property="BorderThickness" Value="2,0,0,1"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#043b82f6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="30" Height="30" CornerRadius="6"
                                                        Background="#123b82f6" HorizontalAlignment="Left">
                                                    <TextBlock Text="👤" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NombreCompleto}" FontSize="13" FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding DNI}" FontFamily="Consolas"
                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="3" Text="{Binding MotivoRegistro}"
                                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding FechaRegistro, StringFormat='{}{0:dd MMM yyyy}'}"
                                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>

                                                <Border Grid.Column="5" CornerRadius="10" Padding="8,3"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1210b981"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Requisitoria.Activa}" Value="True">
                                                                    <Setter Property="Background" Value="#12ef4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="5" Height="5" Margin="0,0,5,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Requisitoria.Activa}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Sin Req."/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Requisitoria.Activa}" Value="True">
                                                                            <Setter Property="Text" Value="Requisitoria"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======== PANEL DERECHO ======== -->
                <Border Grid.Column="1" Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16">

                            <!-- Tab: Verificar / Registrar -->
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="3" Margin="0,0,0,16">
                                <UniformGrid Columns="2">
                                    <Button Content="🔍 Verificar" Style="{StaticResource PrimaryBtn}"
                                            Margin="0,0,2,0"
                                            Command="{Binding VerificarHuellaCommand}"/>
                                    <Button Content="📝 Registrar" Style="{StaticResource SecondaryBtn}"
                                            Margin="2,0,0,0"
                                            Command="{Binding CapturarHuellaRegistroCommand}"/>
                                </UniformGrid>
                            </Border>

                            <!-- SENSOR BIOMETRICO -->
                            <TextBlock Text="SENSOR BIOMETRICO ZK4500" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                            <!-- Huella visual -->
                            <Border Width="150" Height="170" CornerRadius="16"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#103b82f6" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#3b82f6" BlurRadius="30" ShadowDepth="0" Opacity="0.12"/>
                                </Border.Effect>
                                <Grid>
                                    <Border Width="14" Height="14" BorderThickness="2,2,0,0"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/>
                                    <Border Width="14" Height="14" BorderThickness="0,2,2,0"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"/>
                                    <Border Width="14" Height="14" BorderThickness="2,0,0,2"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"/>
                                    <Border Width="14" Height="14" BorderThickness="0,0,2,2"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"/>

                                    <Path Data="M30,5 C16,5 5,16 5,30 V45 C5,59 16,70 30,70 S55,59 55,45 V30 C55,16 44,5 30,5 Z M30,12 C20,12 12,20 12,30 V45 C12,55 20,63 30,63 S48,55 48,45 V30 C48,20 40,12 30,12 Z M30,19 C24,19 19,24 19,30 V45 C19,51 24,56 30,56 S41,51 41,45 V30 C41,24 36,19 30,19 Z M30,26 C27.8,26 26,27.8 26,30 V45 C26,47.2 27.8,49 30,49 S34,47.2 34,45 V30 C34,27.8 32.2,26 30,26 Z"
                                          Stretch="Uniform" Width="60" Height="75"
                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.2"
                                          Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Estado -->
                            <TextBlock Text="{Binding EstadoVerificacion}" FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding EstadoVerificacionDetalle}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                       Margin="0,3,0,16"/>

                            <!-- ======== RESULTADO VERIFICACION ======== -->
                            <Border CornerRadius="10" Padding="14" Margin="0,0,0,12"
                                    Visibility="{Binding ResultadoVisible, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlertaRequisitoria}" Value="True">
                                                <Setter Property="Background" Value="#08ef4444"/>
                                                <Setter Property="BorderBrush" Value="#30ef4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="32" Height="32" CornerRadius="6" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1210b981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlertaRequisitoria}" Value="True">
                                                            <Setter Property="Background" Value="#12ef4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="✓"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlertaRequisitoria}" Value="True">
                                                                <Setter Property="Text" Value="⚠"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PersonaVerificada.NombreCompleto}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Sin requisitoria"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlertaRequisitoria}" Value="True">
                                                                <Setter Property="Text" Value="REQUISITORIA JUDICIAL ACTIVA"/>
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>

                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DNI" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Width="80"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PersonaVerificada.DNI}"
                                                   FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Coincidencia" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Width="80"/>
                                        <TextBlock Grid.Column="1" FontSize="11" FontFamily="Consolas"
                                                   Foreground="{StaticResource AccentBrush}">
                                            <TextBlock.Text>
                                                <Binding Path="PorcentajeCoincidencia" StringFormat="Template Match: {0:F1}%"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <Button Style="{StaticResource DangerBtn}" Margin="0,10,0,0"
                                            Content="Generar Acta de Intervencion"
                                            HorizontalAlignment="Stretch"
                                            Visibility="{Binding AlertaRequisitoria, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- ======== PANEL REQUISITORIA (formulario) ======== -->
                            <Border CornerRadius="10" Padding="14" Margin="0,0,0,12"
                                    Background="#08ef4444" BorderBrush="#30ef4444" BorderThickness="1"
                                    Visibility="{Binding PanelRequisitoriaVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TituloRequisitoria}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>

                                    <!-- Info persona -->
                                    <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                            Background="#06ffffff" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding ReqPersonaInfo}" FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>

                                    <TextBlock Text="DELITO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Text="{Binding ReqDelito, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Text="JUZGADO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Text="{Binding ReqJuzgado, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Text="N° EXPEDIENTE" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource DarkTextBox}" FontFamily="Consolas"
                                             Text="{Binding ReqExpediente, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Text="FECHA DE EMISION" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <DatePicker Style="{StaticResource DarkDatePicker}"
                                                SelectedDate="{Binding ReqFechaEmision}"
                                                Margin="0,0,0,8"/>

                                    <TextBlock Text="DESCRIPCION" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource DarkTextBox}" Height="45"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             Text="{Binding ReqDescripcion, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <!-- Botones requisitoria -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource DangerBtn}" Margin="0,0,6,0"
                                                Command="{Binding GuardarRequisitoriaCommand}">
                                            <TextBlock Text="{Binding TextoBotonRequisitoria}" FontWeight="SemiBold" FontSize="11"/>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource SmallWarningBtn}" Margin="0,0,4,0"
                                                Command="{Binding DesactivarRequisitoriaCommand}"
                                                ToolTip="Desactivar requisitoria (conserva registro)">
                                            <TextBlock Text="Desactivar" FontSize="10"/>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}"
                                                Command="{Binding CancelarRequisitoriaCommand}">
                                            <TextBlock Text="Cerrar" FontSize="11"/>
                                        </Button>
                                    </Grid>

                                    <!-- Boton eliminar requisitoria -->
                                    <Button Style="{StaticResource SmallDangerBtn}" Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding EliminarRequisitoriaCommand}"
                                            ToolTip="Eliminar requisitoria permanentemente">
                                        <TextBlock Text="🗑 Eliminar requisitoria" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ======== FORMULARIO DE REGISTRO / EDICION ======== -->
                            <TextBlock Text="{Binding TituloFormulario}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10"/>

                            <!-- Indicador modo edicion -->
                            <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,10"
                                    Background="#12f59e0b" BorderBrush="#30f59e0b" BorderThickness="1"
                                    Visibility="{Binding ModoEdicion, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✏ Modo edicion — Los cambios se aplicaran al registro seleccionado"
                                           FontSize="11" Foreground="{StaticResource WarningBrush}"/>
                            </Border>

                            <TextBlock Text="DNI" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource DarkTextBox}" FontFamily="Consolas"
                                     Text="{Binding RegDNI, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="8" Margin="0,0,0,10"/>

                            <TextBlock Text="NOMBRE COMPLETO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding RegNombre, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="MOTIVO DE REGISTRO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>

                            <!-- CAMBIO 2: ComboBox con template oscuro completo -->
                            <ComboBox Style="{StaticResource DarkCombo}"
                              ItemContainerStyle="{StaticResource DarkComboItem}"
                              ItemsSource="{Binding MotivosRegistro}"
                              SelectedItem="{Binding RegMotivo}"
                              Margin="0,0,0,10"/>

                            <TextBlock Text="OBSERVACIONES" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Height="50"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Text="{Binding RegObservaciones, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14"/>

                            <!-- Botones -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0"
                                        Command="{Binding RegistrarPersonaCommand}">
                                    <TextBlock Text="{Binding TextoBotonGuardar}" FontWeight="SemiBold"/>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Content="Cancelar"
                                        Command="{Binding CancelarEdicionCommand}"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

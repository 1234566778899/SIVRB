                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                        <TextBlock FontSize="11" FontWeight="Bold">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Setter Property="Text" Value="Sin requisitoria activa" />
                              <Setter Property="Foreground" Value="{StaticResource VerdeDk}" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding PersonaSeleccionada.Requisitoria.Activa}">
                                  <Setter Property="Text" Value="Requisitoria activa" />
                                  <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </TextBlock>
                      </Border>
                    </WrapPanel>
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding PersonaSeleccionada.Observaciones}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="ACCIONES" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                      <Button Style="{StaticResource BtnGhost}" Margin="0,0,4,4" Content="Agregar requisitoria" Command="{Binding AbrirAgregarRequisitoriaCommand}" />
                      <Button Style="{StaticResource BtnGhost}" Margin="4,0,0,4" Content="Editar requisitoria" Command="{Binding AbrirEditarRequisitoriaCommand}" Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVis}}" />
                      <Button Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Content="Editar registro" Command="{Binding EditarPersonaCommand}" />
                      <Button Style="{StaticResource BtnDanger}" Margin="4,0,0,0" Content="Eliminar registro" Command="{Binding EliminarPersonaCommand}" />
                    </UniformGrid>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Background="{StaticResource VerdeLk}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="14,10">
                    <Grid>
                      <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" Background="{StaticResource Verde}" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Registros" Foreground="{StaticResource Negro}" FontSize="14" FontWeight="Bold" />
                          <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding TotalRegistrados, StringFormat='{}{0} personas registradas'}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border DockPanel.Dock="Top" Padding="14,8" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,2">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="0.95*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.95*" />
                        <ColumnDefinition Width="0.95*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="NOMBRE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="DNI" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                      <TextBlock Grid.Column="2" Text="MOTIVO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                      <TextBlock Grid.Column="3" Text="FECHA" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                      <TextBlock Grid.Column="4" Text="ESTADO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
                    </Grid>
                  </Border>
                  <!-- Estados vacios: sin registros / busqueda sin resultados -->
                  <StackPanel DockPanel.Dock="Top" Margin="0,48,0,0" Visibility="{Binding SinRegistros, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource EmptyStateText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Negro}" Text="Aún no hay personas registradas" />
                    <TextBlock Style="{StaticResource EmptyStateText}" Margin="0,4,0,0" Text="Use «+ Nuevo registro» para agregar la primera." />
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="0,48,0,0" Visibility="{Binding SinResultadosBusqueda, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource EmptyStateText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Negro}" Text="Sin resultados" />
                    <TextBlock Style="{StaticResource EmptyStateText}" Margin="0,4,0,0" Text="Ninguna persona coincide con la búsqueda." />
                  </StackPanel>
                  <ListView Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Personas}" SelectedItem="{Binding PersonaSeleccionada}">
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                              <Border Name="RowBorder" Background="#00FFFFFF" BorderBrush="{StaticResource Bg}" BorderThickness="0,0,0,1" Padding="14,10">
                                <ContentPresenter />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="RowBorder" Value="{StaticResource VerdeLk}" Property="Border.Background" />
                                </Trigger>
                                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                  <Setter TargetName="RowBorder" Value="{StaticResource VerdeLk}" Property="Border.Background" />
                                  <Setter TargetName="RowBorder" Value="{StaticResource Verde}" Property="Border.BorderBrush" />
                                  <Setter TargetName="RowBorder" Property="Border.BorderThickness" Value="4,0,0,1" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="0.95*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type Border}">
                                  <Setter Property="Background" Value="{StaticResource VerdeLk}" />
                                  <Style.Triggers>
                                    <DataTrigger Value="True" Binding="{Binding Requisitoria.Activa}">
                                      <Setter Property="Background" Value="{StaticResource DangerBg}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource Verde}" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding Requisitoria.Activa}">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </TextBlock>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Foreground="{StaticResource Negro}" FontSize="12" FontWeight="SemiBold" Text="{Binding NombreCompleto}" />
                              <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxWidth="220" Text="{Binding Observaciones}" />
                            </StackPanel>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Text="{Binding DNI}" />

                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Value="" Binding="{Binding Text, ElementName=BusquedaTextBox}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource BtnMain}" Margin="12,0,0,0" Padding="14,8" Command="{Binding AbrirRegistroModalCommand}">
                  <TextBlock Text="+ Nuevo registro" FontWeight="Bold" />
                </Button>
              </Grid>
              <Border Grid.Row="2" Style="{StaticResource CardBorder}" Visibility="{Binding PersonaSeleccionadaVisible, Converter={StaticResource BoolToVis}}">

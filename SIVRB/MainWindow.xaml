                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="{Binding Percentage, Converter={StaticResource PctStar}}" />
                                      <ColumnDefinition Width="{Binding Percentage, Converter={StaticResource PctStar}, ConverterParameter=rest}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource Verde}" CornerRadius="5" />
                                  </Grid>
                                </Grid>
                                <TextBlock Grid.Column="2" Foreground="{StaticResource Negro}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Grid Margin="18,16" Visibility="{Binding EsOperaciones, Converter={StaticResource BoolToVis}}">

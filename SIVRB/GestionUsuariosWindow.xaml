<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SIVRB.Views.GestionUsuariosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SIVRB - Gestión de usuarios" Height="660" Width="900" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="{StaticResource Bg}" FontFamily="Segoe UI" xmlns:views="clr-namespace:SIVRB.Views;assembly=SIVRB">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource VerdeDk}">
      <Border BorderBrush="{StaticResource Dorado}" BorderThickness="0,0,0,3" Padding="20,12">
        <StackPanel Orientation="Horizontal">
          <Border Width="34" Height="34" Background="{StaticResource Dorado}" CornerRadius="17" VerticalAlignment="Center">
            <TextBlock Text="PNP" Foreground="{StaticResource VerdeDk}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Gestión de usuarios" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="Crear, editar y administrar cuentas de acceso al sistema" Foreground="#FFFFFFA0" FontSize="11" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Grid Row="1" Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="14" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="18">
        <StackPanel>
          <TextBlock Text="Nuevo usuario" Foreground="{StaticResource Negro}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="USUARIO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBox Style="{StaticResource PnpTextBox}" Text="{Binding NuevoNombreUsuario, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="CONTRASEÑA" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
              <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                <PasswordBox Name="NewPasswordField" Background="#00FFFFFF" Foreground="{StaticResource Negro}" BorderThickness="0" Padding="12,8" FontSize="12" CaretBrush="{StaticResource Negro}" PasswordChanged="NewPasswordField_PasswordChanged" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="NOMBRE COMPLETO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBox Style="{StaticResource PnpTextBox}" Text="{Binding NuevoNombreCompleto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Text="ROL" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
              <ComboBox Style="{StaticResource PnpCombo}" SelectedItem="{Binding NuevoRol}">
                <system:String xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:system="clr-namespace:System;assembly=System.Private.CoreLib">Operador</system:String>
                <String xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="clr-namespace:System;assembly=System.Private.CoreLib">Administrador</String>
              </ComboBox>
            </StackPanel>
            <Button Grid.Column="8" Style="{StaticResource BtnMain}" VerticalAlignment="Bottom" Padding="22,9" Command="{Binding CrearUsuarioCommand}">
              <TextBlock Text="Crear" FontSize="12" FontWeight="Bold" />
            </Button>
          </Grid>
          <TextBlock Foreground="{StaticResource VerdeDk}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Mensaje}">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                  <!-- Sin mensaje, no reserva espacio debajo del formulario -->
                  <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                  <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Usuarios registrados" Foreground="{StaticResource Negro}" FontSize="13" FontWeight="Bold" />
          <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Background="#00FFFFFF" Foreground="{StaticResource Negro}" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Border}" RowBackground="{StaticResource BgCard}" AlternatingRowBackground="{StaticResource Bg}" HeadersVisibility="Column" SelectionMode="Single" FontSize="11" RowHeight="46" CanUserResizeRows="False" CanUserReorderColumns="False" ItemsSource="{Binding Usuarios}">
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="{StaticResource VerdeLk}" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
              <Style TargetType="{x:Type DataGridRow}">
                <Setter Property="Foreground" Value="{StaticResource Negro}" />
                <Style.Triggers>
                  <Trigger Property="DataGridRow.IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource VerdeLk}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
              <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource Negro}" />
                <!-- La plantilla por defecto ignora Padding y alinea arriba: se reemplaza para
                     que el contenido quede alineado con los encabezados y centrado verticalmente -->
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="DataGridCell.IsSelected" Value="True">
                    <Setter Property="Background" Value="#00FFFFFF" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Usuario" Width="120" Binding="{Binding NombreUsuario}" />
              <DataGridTextColumn Header="Nombre completo" Width="*" Binding="{Binding NombreCompleto}" />
              <DataGridTextColumn Header="Rol" Width="100" Binding="{Binding Rol}" />
              <DataGridTemplateColumn Header="Estado" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Border}">
                          <Setter Property="Background" Value="{StaticResource DangerBg}" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding Activo}">
                              <Setter Property="Background" Value="{StaticResource SuccessBg}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <TextBlock FontSize="10" FontWeight="Bold">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="Inactivo" />
                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding Activo}">
                                <Setter Property="Text" Value="Activo" />
                                <Setter Property="Foreground" Value="{StaticResource VerdeDk}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Acciones" Width="330">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{x:Null}" Cursor="Hand" Margin="0,0,5,0" Command="{Binding DataContext.ToggleActivoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="B" Background="{StaticResource VerdeLk}" CornerRadius="6" Padding="9,5" MinWidth="78" BorderBrush="#A2D8B5" BorderThickness="1">
                              <!-- Dice que hara el boton segun el estado actual del usuario -->
                              <TextBlock Foreground="{StaticResource VerdeDk}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="Activar" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding Activo}">
                                        <Setter Property="Text" Value="Desactivar" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Border.Background" Value="#D9F1E1" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </Button>
                      <Button Style="{x:Null}" Cursor="Hand" Margin="0,0,5,0" Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="B" Background="{StaticResource WarnBg}" CornerRadius="6" Padding="9,5" MinWidth="78" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1">
                              <TextBlock Text="Restablecer contraseña" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Border.Background" Value="#FCF1D8" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </Button>
                      <Button Style="{x:Null}" Cursor="Hand" Command="{Binding DataContext.EliminarUsuarioCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="B" Background="{StaticResource DangerBg}" CornerRadius="6" Padding="9,5" MinWidth="78" BorderBrush="#F0BAB6" BorderThickness="1">
                              <TextBlock Text="Eliminar" Foreground="{StaticResource Danger}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Border.Background" Value="#FBDDDA" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>